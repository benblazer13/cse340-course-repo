<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <p>Description: <%= project.description %></p>
    <p>Date: <%= new Date(project.date + 'T00:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></p>
    <p>Location: <%= project.location %></p>
    <p>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
</main>
<%- include('partials/footer') %>
