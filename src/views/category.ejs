<%- include('partials/header') %>
<main>
    <h1><%= category.name %></h1>

    <% if (projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <%= new Date(project.date + 'T00:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>:
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No service projects in this category yet.</p>
    <% } %>
</main>
<%- include('partials/footer') %>
